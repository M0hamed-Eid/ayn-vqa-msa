# Copy this file to `.env` and adjust for your machine. `.env` itself is
# gitignored -- only this template is committed.
#
# All variables are read by `src/ayn_vqa/config.py` via pydantic-settings,
# with the `AYNVQA_` prefix. Anything you don't set falls back to the
# default already baked into Settings, so a fresh checkout works with zero
# config as long as the dataset sits in the default sibling location.

# Path to the QCRI/AynVQA-ArabicNLP26 dataset clone (the folder that
# directly contains `images/`, `audio/`, `task1a/`). Relative paths are
# resolved against this project's root, not your shell's cwd.
AYNVQA_DATA_ROOT=../AynVQA-ArabicNLP26

# Where audit reports, figures, and logs are written.
AYNVQA_REPORTS_DIR=reports

# Where cached stage outputs (ASR transcripts, later: parsed transcripts,
# VLM answers, ...) are written -- keyed by split/stage/config, so re-running
# the same config is instant instead of re-calling a model/API.
AYNVQA_ARTIFACTS_DIR=artifacts

# Seed for every random sample (contact sheets, spot checks). Fixed by
# default so results are reproducible run to run.
AYNVQA_RANDOM_SEED=42

# How many items to draw for the random visual sample grid.
AYNVQA_SAMPLE_GRID_N=24

# Max Hamming distance (out of 64 bits) for two images to be flagged as
# near-duplicates by the perceptual hash. 0 = only exact-bit matches.
AYNVQA_NEAR_DUP_MAX_DISTANCE=4

# Python `logging` level for console/file output.
AYNVQA_LOG_LEVEL=INFO

# --- ASR (M2) ---------------------------------------------------------------
# How many items to draw for a seeded ASR bench sample.
AYNVQA_ASR_SAMPLE_N=50

# Local Whisper (via faster-whisper). Runs offline, no key needed, no cost --
# the only ASR backend actually exercised in this project so far. Bigger
# model_size = better transcripts, slower. "cpu"/"int8" works with no GPU;
# switch device to "cuda" and compute_type to "float16" if you have one.
AYNVQA_WHISPER_MODEL_SIZE=medium
AYNVQA_WHISPER_DEVICE=cpu
AYNVQA_WHISPER_COMPUTE_TYPE=int8

# Fanar Aura-STT (https://api.fanar.qa/request). Leave unset to skip this
# backend -- FanarAuraASR raises a clear error at construction if the key
# is missing, rather than failing confusingly mid-run.
AYNVQA_FANAR_API_KEY=
AYNVQA_FANAR_BASE_URL=https://api.fanar.qa/v1
AYNVQA_FANAR_STT_MODEL=Fanar-Aura-STT-1

# OpenAI transcription API. Leave unset to skip this backend.
AYNVQA_OPENAI_API_KEY=
AYNVQA_OPENAI_BASE_URL=https://api.openai.com/v1
AYNVQA_OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# --- Pipeline / VLM (M3) -----------------------------------------------------
# How many items to run the full cascade over; leave unset (empty) to run
# the entire split -- that's what a real dev/devtest run needs, but start
# small (e.g. via --sample-n on the CLI) the first time you try a new model.
AYNVQA_PIPELINE_SAMPLE_N=

# Local Qwen2.5-VL via Ollama (https://ollama.com) -- no API key, no cost.
# Used for both transcript parsing (text-only) and joint-MCQ image
# answering. Requires `ollama pull qwen2.5vl:7b` and `ollama serve` running.
AYNVQA_OLLAMA_BASE_URL=http://localhost:11434
AYNVQA_OLLAMA_PARSE_MODEL=qwen2.5vl:7b
AYNVQA_OLLAMA_SELECT_MODEL=qwen2.5vl:7b
